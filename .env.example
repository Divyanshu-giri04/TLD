# ===== The Launch Desk — Environment Configuration =====

# Server
PORT=3000

# JWT secret (REQUIRED) — change to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Seed admin credentials (used on first boot)
ADMIN_EMAIL=admin@thelaunchdesk.io
ADMIN_PASSWORD=Admin@2026


# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Database =====
# MongoDB is the primary database.
# Set MONGODB_URI to use MongoDB. If unset or unreachable, the app falls
# back to the built-in SQLite database so the server always boots.
MONGODB_URI=mongodb://localhost:27017/thelaunchdesk

# Legacy: set DATABASE_URL to use Postgres instead of SQLite (deprecated)
# DATABASE_URL=postgres://user:pass@localhost:5432/thelaunchdesk
