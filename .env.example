# The Launch Desk — environment configuration
# Copy to .env and fill in real values.

# --- REQUIRED ---
# Secret used to sign JWTs. MUST be a long random string. The app refuses to
# boot without it (no insecure fallback).
JWT_SECRET=change-me-to-a-long-random-string

# --- Auth ---
# Admin login email/password (used to seed the first admin user on a fresh DB)
ADMIN_EMAIL=admin@thelaunchdesk.io
ADMIN_PASSWORD=Admin@2026

# --- Server ---
HOST=0.0.0.0
PORT=3000

# --- Database ---
# Unset to use the built-in sql.js file (tld.db).
# Set to a Postgres connection string to use Postgres (recommended for Docker/deploy):
DATABASE_URL=

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

